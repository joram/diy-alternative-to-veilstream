DATABASE_URL=postgres://postgres:postgres@localhost:5435/chinook
PORT=3001
ADMIN_PASSWORD=admin
CORS_ORIGIN=http://localhost:5173

# LLM for support bot — Docker Compose defaults to Ollama + qwen2.5:1.5b
LLM_PROVIDER=ollama
OPENAI_API_KEY=ollama
OPENAI_MODEL=qwen2.5:1.5b
OPENAI_BASE_URL=http://localhost:11434/v1
LLM_TIMEOUT_MS=120000

# Cloud OpenAI instead (local dev):
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
